# Backend Environment Variables Example

# Port for Express server to listen on
PORT=5000

# Client URL for CORS configuration (e.g. http://localhost:5173 or https://portfolio.rithish.site)
CLIENT_URL=http://localhost:5173

# PostgreSQL / Supabase connection URL
SUPABASE_URL=postgresql://postgres:password@localhost:5432/portfolio

# Admin Authentication Secret (for signed cookies/JWT)
ADMIN_JWT_SECRET=your-secret-key-here

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@rithish.site
SENDER_NAME="Rithish S"
NOTIFICATION_EMAIL=
