# Backend Environment Variables Example

# Port for Express server to listen on
PORT=5000

# Client URL for CORS configuration (e.g. http://localhost:5173 or https://your-portfolio.vercel.app)
CLIENT_URL=http://localhost:5173

# PostgreSQL / Supabase connection URL
SUPABASE_URL=postgresql://postgres:password@localhost:5432/portfolio

# Admin Authentication Secret (for signed cookies/JWT)
ADMIN_JWT_SECRET=your-secret-key-here

# Email / SMTP Configuration (for sending resume & receiving notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rithishcodespace@gmail.com
SMTP_PASS=Rithish@2006
SENDER_NAME=Rithish S
NOTIFICATION_EMAIL=rithishcodespace@gmail.com
